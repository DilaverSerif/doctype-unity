 // litehtml's hit-test entry points want a redraw-box sink; we repaint the whole
 // view every frame, so we only care whether anything changed at all.
 const std::function<void(const litehtml::position&)> kIgnoreRedraw = [](const litehtml::position&) {};
+
+// --- shared master stylesheet ------------------------------------------------
+//
+// A parsed litehtml stylesheet is normally tied to the document it was parsed
+// against. These two checks decide whether a particular parsed sheet actually is,
+// so that we only ever share one that is not. See document.h (LHU PATCH) for the
+// full reasoning; in short a selector is document-dependent if it either
+//
+//   * carries a media query — media_query_list_list::m_is_used is mutable state
+//     that document::update_media_lists() flips per document, and the list has to
+//     be registered in document::m_media_lists to be evaluated at all; or
+//   * contains a `.class` or `#id` simple selector — litehtml lowercases those
+//     names at parse time in quirks mode, so the parsed form differs between a
+//     quirks and a no-quirks document.
+//
+// Neither master stylesheet we ship contains any of that, but the check is cheap
+// and runs once, and it is what keeps this safe if either sheet ever grows an
+// @media block or a class selector.
+
+bool selector_is_document_independent(const litehtml::css_selector& sel);
+
+bool compound_is_document_independent(const litehtml::css_element_selector& compound)
+{
+    for(const auto& attr : compound.m_attrs)
+    {
+        if(attr.type == litehtml::select_class || attr.type == litehtml::select_id)
+        {
+            return false;
+        }
+        // :not(...) / :nth-child(... of ...) nest a whole selector list
+        for(const auto& nested : attr.selector_list)
+        {
+            if(!nested || !selector_is_document_independent(*nested))
+            {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+bool selector_is_document_independent(const litehtml::css_selector& sel)
+{
+    if(sel.m_media_query)
+    {
+        return false;
+    }
+    if(!compound_is_document_independent(sel.m_right))
+    {
+        return false;
+    }
+    return !sel.m_left || selector_is_document_independent(*sel.m_left);
+}
+
+// Parses `text` once and returns it if the result is safe to share, else nullptr.
+//
+// css::parse_css_stylesheet() needs a document, but only for document::mode() (fed
+// to parse_selector_list) and document::container() (fed to style::add, which uses
+// it solely for document_container::resolve_color on non-standard colour names).
+// A scratch document supplies both and is thrown away; it accumulates nothing else
+// as long as the sheet has no @media/@import, which the check above enforces.
+std::shared_ptr<litehtml::css> parse_shared_master_css(const char*                   text,
+                                                       litehtml::document_container* container)
+{
+    if(!text || !*text)
+    {
+        return nullptr;
+    }
+
+    auto sheet   = std::make_shared<litehtml::css>();
+    auto scratch = std::make_shared<litehtml::document>(container);
+    sheet->parse_css_stylesheet(std::string(text), "", scratch);
+    sheet->sort_selectors();
+
+    for(const auto& sel : sheet->selectors())
+    {
+        if(!sel || !selector_is_document_independent(*sel))
+        {
+            return nullptr;
+        }
+    }
+    return sheet;
+}
