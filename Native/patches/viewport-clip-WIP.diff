+// Field-wise equality. Deliberately does not memcmp the whole struct: LhuQuad
+// carries an explicit `_pad` word that nothing is required to initialise.
+bool same_quad(const LhuQuad& a, const LhuQuad& b)
+{
+    if(a.x != b.x || a.y != b.y || a.w != b.w || a.h != b.h)
+    {
+        return false;
+    }
+    for(int i = 0; i < 4; ++i)
+    {
+        if(a.rx[i] != b.rx[i] || a.ry[i] != b.ry[i] || a.border[i] != b.border[i] || a.clip_r[i] != b.clip_r[i] ||
+           a.params[i] != b.params[i])
+        {
+            return false;
+        }
+    }
+    if(a.clip_x != b.clip_x || a.clip_y != b.clip_y || a.clip_w != b.clip_w || a.clip_h != b.clip_h)
+    {
+        return false;
+    }
+    if(a.u0 != b.u0 || a.v0 != b.v0 || a.u1 != b.u1 || a.v1 != b.v1)
+    {
+        return false;
+    }
+    return a.grad_row == b.grad_row && a.type == b.type && a.color == b.color;
+}
+
+// The one quad that is *allowed* to differ between a clipped and an unclipped
+// recording: the canvas backdrop.
+//
+// litehtml hands the root element's background the clip rect it was given
+// (html_tag.cpp:986, `if(is_root() && clip) layer.border_box = *clip`), and
+// lhu_container's paint_box() then grows that box to at least the viewport
+// (lhu_container.cpp:521). So the backdrop is max(clip, viewport) either way —
+// which is what a browser does: the canvas background always fills the view.
+// Everything else must survive culling byte-for-byte.
+bool is_canvas_backdrop_pair(const LhuQuad& sub, const LhuQuad& full)
+{
+    return sub.type == LHU_QUAD_RECT && full.type == LHU_QUAD_RECT && sub.color == full.color && sub.x == 0.f &&
+           full.x == 0.f && sub.y == 0.f && full.y == 0.f && sub.w == full.w;
+}
+
+// Is `sub` an in-order subsequence of `full`? Culling may only *remove* quads;
+// it must never reorder, alter or invent one. Returns -1 when it is a clean
+// subsequence, otherwise the index of the first quad in `sub` that has no
+// match. The leading canvas backdrop is exempt (see above); when it was matched
+// that way its two heights are written to `backdrop_h`.
+int first_unmatched(const std::vector<LhuQuad>& sub, const std::vector<LhuQuad>& full, float backdrop_h[2])
+{
+    backdrop_h[0] = backdrop_h[1] = 0.f;
+
+    size_t j = 0;
+    for(size_t i = 0; i < sub.size(); ++i)
+    {
+        if(i == 0 && !full.empty() && !same_quad(sub[0], full[0]) && is_canvas_backdrop_pair(sub[0], full[0]))
+        {
+            backdrop_h[0] = full[0].h;
+            backdrop_h[1] = sub[0].h;
+            j             = 1;
+            continue;
+        }
+
+        while(j < full.size() && !same_quad(sub[i], full[j]))
+        {
+            ++j;
+        }
+        if(j == full.size())
+        {
+            return static_cast<int>(i);
+        }
+        ++j;
+    }
+
+    return -1;
+}
+
+std::vector<LhuQuad> snapshot(const LhuFrame& frame)
+{
+    return std::vector<LhuQuad>(frame.quads, frame.quads + frame.quad_count);
+}
