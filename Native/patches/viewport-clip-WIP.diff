@@ -63,6 +63,32 @@
 // Runs layout at the given available width. Returns the document height.
 LHU_API float lhu_layout(LhuContext* ctx, float max_width);
 
+// Restricts what lhu_record() walks to a document-space rectangle, so content
+// scrolled out of view costs nothing. litehtml already tests every element box
+// against the clip it is handed, so this is a real tree-level cull, not a
+// post-filter on the emitted quads.
+//
+// `x`/`y` are document-space (i.e. for a view scrolled down by S, pass y = S).
+// Pass w <= 0 or h <= 0 to go back to recording the whole document, which is
+// also the default for a fresh context.
+//
+// Culling is per element and tests the element's own border box, so anything
+// that paints outside that box can be dropped near the clip edge. Two cases are
+// known and both only bite once `y` is non-zero, i.e. once you scroll:
+//
+//   * position:fixed content. This engine has no scroll offset — the viewport
+//     litehtml sees is always anchored at the document origin (Container::
+//     get_viewport), so a fixed element lives at document y in [0, viewport_h]
+//     and a scrolled clip culls it. Measured: a fixed bar disappears at y=800.
+//   * the canvas backdrop (the root/body background). litehtml hands the root
+//     background the clip rect, and Container::paint_box then pins it to the
+//     document origin and grows it to at least the viewport, so a scrolled clip
+//     still paints it at (0,0) and the scrolled region has no page background.
+//
+// Recording the whole document (the default) and recording the top of it
+// (y == 0) are both unaffected.
+LHU_API void lhu_set_record_clip(LhuContext* ctx, float x, float y, float w, float h);
+
 // Walks the laid-out tree and fills `out` with this frame's quads plus the
 // current atlas state. Pointers in `out` stay valid until the next call.
 LHU_API void lhu_record(LhuContext* ctx, LhuFrame* out);
