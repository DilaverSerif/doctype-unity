# --- Unity -------------------------------------------------------------------
# Library/ is the asset database and import cache: 2 GB here, regenerated from
# Assets/ and ProjectSettings/ on the next open.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Generated by the IDE integrations, never authored.
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb.meta
*.opendb
*.VC.db
.vs/
.vscode/
.idea/

# Crash reports and asset importer leftovers.
sysinfo.txt
*.stackdump
crashlytics-build.properties
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# --- native ------------------------------------------------------------------
# Object files and the cross-compiled binaries. build_macos.sh, build_ios.sh,
# build_android.sh and bench_android.sh all regenerate what they need; the
# Android tree alone is over 100 MB.
/Native/build/

# The benchmark and harness write their renders here.
/Native/build/out/

# Unity's own Android build tree: CMake caches, ninja logs and object files for
# the GameActivity wrapper. Regenerated by every player build.
/.utmp/

# Mono writes these next to the project when the editor crashes.
mono_crash.*.json

# --- macOS -------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes

# --- note --------------------------------------------------------------------
# The compiled plugins under Assets/LiteHtmlUnity/Plugins/ ARE tracked, even
# though Native/build_*.sh regenerates them: Unity loads them from there, so a
# fresh checkout is otherwise a project that opens with missing native code.
# They total ~8.6 MB. If native churn makes that history too heavy, ignore them
# here and build the plugins as a step before opening the project instead.
